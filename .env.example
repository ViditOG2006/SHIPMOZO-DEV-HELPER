# Pick ONE provider (or set AI_PROVIDER=openai|claude|gemini|openrouter)

# OpenAI (recommended if you don't have Claude)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini (optional)
# GEMINI_API_KEY=AIza...

# OpenRouter — one key, many models (optional)
# OPENROUTER_API_KEY=sk-or-...

# Force provider if multiple keys exist
# AI_PROVIDER=openai

# Cloudinary screenshots
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of your deployment (required for screenshot links in production)
PUBLIC_BASE_URL=http://127.0.0.1:3000

SHIPMOZO_EMAIL=
SHIPMOZO_PASSWORD=
HEADLESS=true
PORT=3000
HOST=0.0.0.0

# Linux/Docker use python3 (set automatically in Dockerfile)
# PYTHON_BIN=python3
