# AI — default provider (UI / test gen). Reports can split orchestrator vs compile:
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Cheaper/faster compile: ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Split report gen: Azure/OpenAI for MCP loops, Claude for final PRD/manual only
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# REPORT_ORCHESTRATOR_PROVIDER=azure-openai
# REPORT_ORCHESTRATOR_MODEL=gpt-4.1-mini
# Or use public OpenAI: REPORT_ORCHESTRATOR_PROVIDER=openai + OPENAI_API_KEY
# REPORT_COMPILE_PROVIDER=claude
# REPORT_COMPILE_MODEL=claude-sonnet-4-20250514

# Client-side Claude rate-limit guard (avoids 10k TPM / 5 RPM errors)
# LLM_THROTTLE=true
# ANTHROPIC_TPM_LIMIT=9000
# ANTHROPIC_RPM_LIMIT=4
# LLM_COOLDOWN_MS=12000
# LLM_RATE_LIMIT_RETRY=true
# LLM_RATE_LIMIT_RETRY_MS=65000
# LLM_TIMEOUT_MS=600000
# DOCS_GEN_FAST=true              — PRD ~30s + capture ~75s + manual ~30s (Azure gpt-4.1-mini)
# DOCS_PRD_MAX_TOKENS=3000
# DOCS_MANUAL_MAX_TOKENS=2800
# DOCS_PRD_TIMEOUT_MS=120000
# DOCS_MANUAL_TIMEOUT_MS=120000
# PRD_IN_MANUAL_MAX_CHARS=4000
# REPORT_PRD_PROVIDER=azure-openai
# REPORT_PRD_MODEL=gpt-4.1-mini
# REPORT_GEN_PACE_MS=0
# DOCS_CAPTURE_TIMEOUT_MS=90000
# DOCS_SCREENSHOT_TIMEOUT_MS=45000   — Playwright page.screenshot() timeout (Render: 45s; local fast: 8s)
# DOCS_CAPTURE_BUDGET_S=120          — Python fast-capture wall clock (login + Ctrl+B nav + inline heal)
# DOCS_CAPTURE_SINGLE_SHOT=0        — 0 = multiple section screenshots; 1 = one shot + video
# DOCS_CAPTURE_MAX_ATTEMPTS=2
# DOCS_CAPTURE_FAST=true
# DOCS_HEADLESS=true
# DOCS_CAPTURE_ALLOW_DIRECT_URL=false   — default with fast capture; use Ctrl+B Quick Search only
# DOCS_CAPTURE_USE_NAV_MAP=true         — fall back to data/panel-navigation.json when QS fails
# DOCS_CAPTURE_ALLOW_NAV_MAP_URL=true   — goto href from nav map (trusted routes)
# DOCS_CAPTURE_POST_NAV_WAIT_S=2.5      — pause after navigation before screenshots
# DOCS_VIDEO_WALKTHROUGH_S=12           — seconds on page before saving screen recording
# DOCS_ADD_ORDER_VIDEO_S=18             — longer recording for Add Order form walkthrough
#
# Screenshot self-heal on capture failure (404/login/timeout) — Claude + optional Playwright MCP:
# DOCS_CAPTURE_HEAL_ENABLED=true
# DOCS_CAPTURE_HEAL_PROVIDER=claude
# DOCS_CAPTURE_HEAL_MODEL=claude-sonnet-4-20250514
# DOCS_CAPTURE_HEAL_ATTEMPTS=5
# DOCS_CAPTURE_HEAL_MCP=true
# DOCS_CAPTURE_BUDGET_S=180
# DOCS_CAPTURE_TIMEOUT_MS=180000
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# Backends — minimal AI (recommended): you provide scripts; MCP heals nav on failure
SCRIPT_DEBUG_BACKEND=mcp
# TESTCASE_BACKEND=scripts
# AI_SCOPE=script_debug
# Add testcase_gen,report_gen if you want AI doc/test generation. Add chat for AI Chat tab.
#
# Optional doc-based test generation (uses AI):
# TESTCASE_BACKEND=docs          — single LLM pass from PRD + manual
# TESTCASE_BACKEND=docs-mcp      — LLM + Playwright MCP verify (most AI)
# TESTCASE_BACKEND=postman       — Postman collection (optional)
# REPORT_BACKEND=split            — default: Claude PRD → Playwright → Azure OpenAI manual
# REPORT_PRD_PROVIDER=claude
# REPORT_MANUAL_PROVIDER=azure-openai
# TESTCASE_PROVIDER=claude
# TESTCASE_MODEL=claude-sonnet-4-20250514
# TESTCASE_FAST=true
# DATASET_LLM_TIMEOUT_MS=180000
# DOCS_RECORD_VIDEO=true
# DOCS_PRD_INCLUDE_GITHUB=false
# REPORT_BACKEND=mcp              — slower: MCP gather + compile (optional)
# REPORT_MCP_AGENT_ROUNDS=2
# DOCS_PRD_MAX_HEAL_ATTEMPTS=1
# REPORT_GEN_PACE_MS=8000         — gap between PRD and manual LLM calls (rate-limit guard)
# PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp
# PLAYWRIGHT_MCP_AUTO_START=true
# Hybrid backend + frontend testing:
# TESTCASE_BACKEND=scripts        — frontend: import Playwright E2E scripts (no AI)
# SCRIPT_DEBUG_BACKEND=mcp        — frontend heal: Playwright MCP (nav + scenario e2eFlow; no OpenRouter)
# API_RUN_BACKEND=postman-mcp     — run API scenarios: Newman + Postman API (not MCP runCollection)
# API_RUN_BACKEND=http            — or direct HTTP to SHIPMOZO_API_BASE_URL per scenario
# SHIPMOZO_API_BASE_URL=https://api.your-backend.com
# SHIPMOZO_API_TOKEN=Bearer ...   — optional auth for http mode
# POSTMAN_MCP_AGENT_ROUNDS=12     — AI→Postman MCP turns to create collection + tests
# Or set TESTCASE_BACKEND=postman-mcp to use agent for plain "Generate test dataset" too
# POSTMAN_MCP_URL=https://mcp.postman.com/minimal
# POSTMAN_API_KEY=
# POSTMAN_COLLECTION_ID=
# POSTMAN_ENVIRONMENT_ID=
# POSTMAN_WORKSPACE_ID=

# AI_SCOPE — comma-separated scopes (default includes chat).
#   script_debug  — E2E nav/scenario self-heal (Playwright MCP when SCRIPT_DEBUG_BACKEND=mcp)
#   testcase_gen  — AI test dataset / Postman agent
#   report_gen    — PRD + user manual generation
#   chat          — AI Chat tab (panel Q&A); required for /api/ai/chat
# Example with all scopes:
# AI_SCOPE=script_debug,testcase_gen,report_gen,chat

# Cloudinary screenshots
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Render (native Node web service) ---
# Push repo → Render Dashboard → New → Web Service (or Blueprint with render.yaml)
# Runtime: Node | Build: bash scripts/render-build.sh | Start: node server.js
# PUBLIC_TUNNEL=false on Render — public URL:
# PUBLIC_BASE_URL=https://shipmozo-dev-helper-1.onrender.com
# Free plan: no credit card; service sleeps after 15 min idle.

# --- Local dev only: Cloudflare quick tunnel (NOT used on Render) ---
# On Render, PUBLIC_TUNNEL is off and RENDER_EXTERNAL_URL is your public HTTPS link.
PUBLIC_TUNNEL=true
# TUNNEL_AUTO_DOWNLOAD=true
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe

# Optional local override. On Render leave blank — RENDER_EXTERNAL_URL is used automatically.
# PUBLIC_BASE_URL=http://127.0.0.1:3000

SHIPMOZO_EMAIL=
SHIPMOZO_PASSWORD=

# Optional: public GitHub repo of the panel under test (also configurable in API Settings UI)
# GITHUB_REPO_URL=https://github.com/your-org/shipmozo-panel
# GITHUB_TOKEN=ghp_...  # optional — avoids GitHub API rate limits for private repos you own
# Merchant panel URL
# SHIPMOZO_PANEL_URL=https://panel.appiify.com
# Comma-separated module names treated as backend/API-only (no panel UI, no screenshots)
# BACKEND_ONLY_MODULES=Pincode Serviceability,Webhook Handler
HEADLESS=false
# Minimum 180s recommended for Rate Calculator E2E (login + navigate)
# PANEL_E2E_TIMEOUT_MS=180000
PORT=3000
HOST=0.0.0.0

# Linux/Docker use python3 (set automatically in Dockerfile)
# PYTHON_BIN=python3
